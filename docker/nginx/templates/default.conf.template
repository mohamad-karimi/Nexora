# Reverse proxy for Nexora (production).
#
# Rendered by the stock `nginx` image's own entrypoint, which runs
# envsubst on every *.template file under /etc/nginx/templates/ before
# starting (see docker-compose.prod.yml `nginx` service) -- no custom
# image/entrypoint needed. Only ${DOMAIN} is substituted; nginx's own
# variables ($host, $remote_addr, ...) are untouched because they are not
# environment variables.
#
# TLS: this config always points ssl_certificate/ssl_certificate_key at
# /etc/letsencrypt/live/${DOMAIN}/. On a brand new host that path does not
# exist yet, which is exactly why scripts/init-letsencrypt.sh creates a
# short-lived self-signed "dummy" certificate there FIRST, then swaps it
# for a real Let's Encrypt certificate obtained through the
# /.well-known/acme-challenge/ location below -- see
# docs/production-deployment.md.

upstream nexora_backend {
    server backend:8000;
}

# Gzip: compress the text-ish responses (HTML/JSON/CSS/JS); images/fonts
# are already compressed formats and are skipped.
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 256;
gzip_types
    text/plain
    text/css
    text/xml
    application/json
    application/javascript
    application/xml
    application/xml+rss
    image/svg+xml;

# Uploads (product/vendor images) go through Django's own forms, not a
# large binary API, but this must stay >= the largest expected upload
# (default here: 20 MB) or Nginx rejects the request with 413 before it
# ever reaches Gunicorn.
client_max_body_size 20m;

# --- Port 80: ACME challenge + HTTP->HTTPS redirect --------------------
server {
    listen 80;
    server_name ${DOMAIN};

    # Required for the very first certificate issuance and every renewal
    # (certbot's webroot plugin, see scripts/init-letsencrypt.sh). Must
    # stay reachable over plain HTTP even after HTTPS is enabled.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Nginx-level liveness check: proves Nginx itself is up, independent
    # of Django/Gunicorn (see docker-compose.prod.yml healthcheck).
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- Port 443: the real site --------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Real request/proxy headers so Django (SECURE_PROXY_SSL_HEADER,
    # ALLOWED_HOSTS) sees the original client and scheme, not Nginx's.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect off;

    # Security headers. CSP was built by checking the project's actual
    # external resources (sweetalert2 via jsdelivr, Leaflet via unpkg,
    # Mapbox/OSM/CartoDB map tiles) -- see docs/production-deployment.md
    # for how to re-verify this if a new CDN/script is added later.
    # 'unsafe-inline' is required for both script-src and style-src
    # because the existing theme uses inline <script> blocks and
    # style="" attributes throughout its templates; removing it would
    # require a template-wide refactor that is out of scope here.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com; img-src 'self' data: https://api.mapbox.com https://*.tile.openstreetmap.org http://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com http://*.basemaps.cartocdn.com; font-src 'self' data:; connect-src 'self' https://api.mapbox.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" always;
    # Only takes effect once SECURE_HSTS_SECONDS > 0 is also set in
    # Django's .env (see core/core/settings.py) -- kept out of Nginx by
    # default so the two can't drift; add it here only after HSTS is
    # verified end-to-end.

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Static assets: served directly by Nginx from the volume populated by
    # `collectstatic` (see docker-compose.prod.yml, docs/production-
    # deployment.md). Filenames are content-stable (not hashed), so a
    # long-lived cache header is safe.
    location /static/ {
        alias /usr/src/app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    # Media (vendor/product uploads): served directly from the persistent
    # media volume. Shorter cache: these files can be replaced/removed by
    # vendors/admins.
    location /media/ {
        alias /usr/src/app/media/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }

    # Everything else (HTML pages, /api/, /admin/, auth, cart, checkout):
    # proxied to Gunicorn, never cached at the Nginx layer.
    location / {
        proxy_pass http://nexora_backend;
        proxy_http_version 1.1;
        add_header Cache-Control "no-store" always;
    }
}
