# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed (see .gitignore).
# In CI, these are supplied as dummy/placeholder values by the workflow
# itself -- no secrets are needed to run the test suite.
# In production, this file lives only on the server, next to
# docker-compose.prod.yml, and is populated with real values.

# Django
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Email (Gmail SMTP app password, or another provider's SMTP creds)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# django.contrib.sites (see core/website/migrations/0005_configure_site.py)
SITE_DOMAIN=localhost:8000
SITE_DISPLAY_NAME=Nexora (Local)

# Optional: only needed in production (see docker-compose.prod.yml), where
# it points the SQLite file at a persistent volume instead of the
# container's ephemeral filesystem. Leave unset for local dev.
# DATABASE_PATH=/usr/src/app/data/db.sqlite3
