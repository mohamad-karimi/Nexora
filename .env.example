# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed (see .gitignore).
# In CI, these are supplied as dummy/placeholder values by the workflow
# itself -- no secrets are needed to run the test suite.
# In production, this file lives only on the server, next to
# docker-compose.prod.yml, and is populated with real values.

# Django
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Extra origins allowed to pass the CSRF check, e.g. the production domain
# over https. Required in production once DEBUG=False and the site is
# served over HTTPS behind Nginx.
# CSRF_TRUSTED_ORIGINS=https://example.com

# Production security (see core/core/settings.py for the full list and
# defaults). Everything below defaults sensibly from DEBUG, so none of it
# needs to be set for local dev. In production:
#   1. Deploy with SECURE_SSL_REDIRECT=False first and confirm HTTPS works
#      end-to-end (see docs/production-deployment.md).
#   2. Only then set SECURE_HSTS_SECONDS (e.g. 31536000 for one year) --
#      it cannot be safely undone client-side once browsers have cached it.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False

# Email (Gmail SMTP app password, or another provider's SMTP creds)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Seconds before an SMTP connection gives up (default 10).
# EMAIL_TIMEOUT=10

# django.contrib.sites (see core/website/migrations/0005_configure_site.py
# and, for keeping it in sync on later deploys, `manage.py sync_site` /
# core/website/management/commands/sync_site.py). In production this must
# be the bare domain Nginx and Let's Encrypt use (e.g. "example.com"), no
# scheme/port -- see docker/nginx/templates/default.conf.template and
# scripts/init-letsencrypt.sh, which both read SITE_DOMAIN too.
SITE_DOMAIN=localhost:8000
SITE_DISPLAY_NAME=Nexora (Local)

# E-mail address Let's Encrypt uses for expiry/problem notices about the
# certificate for SITE_DOMAIN. Required only to run
# scripts/init-letsencrypt.sh / scripts/renew-certs.sh (production HTTPS
# bootstrap) -- unused otherwise.
# CERTBOT_EMAIL=admin@example.com
# Set to 1 to use Let's Encrypt's staging environment (higher rate limits,
# untrusted certs) while testing the bootstrap script itself.
# CERTBOT_STAGING=0

# PostgreSQL (production database -- see core/core/settings.py). Leave all
# of these unset for local dev / CI, which keep using the existing SQLite
# file. Setting POSTGRES_DB switches Django to PostgreSQL.
# POSTGRES_DB=nexora
# POSTGRES_USER=nexora
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# Optional: only relevant for a non-Docker/non-Postgres local run, where
# it points the SQLite file at a persistent location instead of the
# project directory. Leave unset for local dev under Docker.
# DATABASE_PATH=/usr/src/app/data/db.sqlite3

# Redis (see core/redis_client.py; connectivity check: GET /health/redis/)
# docker-compose.yml and docker-compose.prod.yml run a `redis` service and
# force REDIS_HOST=redis for the backend container, so under Docker only
# the password needs to be set here. The other REDIS_* values matter only
# when running Django outside Docker against your own Redis.
# REDIS_PASSWORD is REQUIRED in production (docker-compose.prod.yml refuses
# to start without it); leave it empty for local dev to run Redis without
# authentication. Generate one with:  openssl rand -hex 32
# (use hex/alphanumeric only -- Docker Compose interpolates "$" in .env)
REDIS_PASSWORD=
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_SSL=False
# REDIS_SOCKET_CONNECT_TIMEOUT=2
# REDIS_SOCKET_TIMEOUT=2

# Public cache (Redis): published products, categories, tags, vendors, home
# slider/banners and published blog posts are cached as query results and
# invalidated whenever they change. Nothing user-specific is ever cached.
# It uses the same Redis service as above, on its own logical database.
# REDIS_CACHE_DB=2
# Seconds before a cache call to Redis gives up (fails fast, falls back to
# the database):
# REDIS_CACHE_SOCKET_TIMEOUT=1
# Set to False to bypass the cache entirely (every request hits the
# database). Cached data is left in Redis; changes are still invalidated.
# PUBLIC_CACHE_ENABLED=True
# After a Redis error the cache is skipped for this many seconds:
# PUBLIC_CACHE_FAILURE_COOLDOWN=30
# Full override of the derived cache URL (rarely needed):
# CACHE_URL=redis://:password@redis:6379/2
# Bump after a deploy that adds/removes fields on a cached model (products,
# categories, tags, vendors, slides, banners, posts) so entries stored by the
# old code are never read (they simply expire):
# CACHE_KEY_VERSION=1

# Celery (background jobs: verification / password-reset emails).
# The broker is the same Redis service as above, on its own logical
# database. Emails are sent by the separate `worker` service in
# docker-compose*.yml (`celery -A core worker`); without a running worker
# queued emails simply wait in Redis.
# REDIS_BROKER_DB=1
# Full override of the derived broker URL (rarely needed):
# CELERY_BROKER_URL=redis://:password@redis:6379/1
# Run tasks inline instead of through the broker -- for a local run with no
# Redis/worker only. NEVER enable in production (SMTP would block requests).
# CELERY_TASK_ALWAYS_EAGER=False

# Mapbox access token for the Leaflet map on the contact page
# (core/website/views.py ContactView, core/static/js/plugins/leaflet.js).
# Get a token at https://account.mapbox.com/access-tokens/ -- a public
# (pk.*) token is enough since it is exposed to the browser either way.
# Leave unset in dev if you don't need the map tiles to render.
MAPBOX_ACCESS_TOKEN=
